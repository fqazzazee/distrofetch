#!/usr/bin/env bash
# distrofetch — matrix-styled system information for Linux.
#
# Resolves its library directory from either a source checkout (../lib) or an
# installed prefix (../lib/distrofetch), so `git clone` and `make install` both work.

set -euo pipefail

DISTROFETCH_VERSION="0.1.0"

die() {
  printf 'distrofetch: %s\n' "$1" >&2
  exit 2
}

# Follow symlinks so a /usr/local/bin/distrofetch -> ../share/... link still finds lib/.
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _link="$(readlink "$_self")"
  case "$_link" in
    /*) _self="$_link" ;;
    *) _self="$(dirname "$_self")/$_link" ;;
  esac
done
_bindir="$(cd "$(dirname "$_self")" && pwd)"

if [ -d "$_bindir/../lib/distrofetch" ]; then
  DISTROFETCH_LIB="$(cd "$_bindir/../lib/distrofetch" && pwd)"
elif [ -d "$_bindir/../lib" ]; then
  DISTROFETCH_LIB="$(cd "$_bindir/../lib" && pwd)"
else
  die "cannot locate library directory relative to $_bindir"
fi

# The reference tables and the logo art sit beside the shell libraries, so both
# layouts resolve from the same base.
DISTROFETCH_DATA="$DISTROFETCH_LIB/data"
DISTROFETCH_LOGOS="$DISTROFETCH_LIB/logos"
DISTROFETCH_CPU_LOGOS="$DISTROFETCH_LIB/cpu-logos"
readonly DISTROFETCH_LIB DISTROFETCH_DATA DISTROFETCH_LOGOS DISTROFETCH_CPU_LOGOS
readonly DISTROFETCH_VERSION

# shellcheck source=../lib/dmi.sh
. "$DISTROFETCH_LIB/dmi.sh"
# shellcheck source=../lib/detect.sh
. "$DISTROFETCH_LIB/detect.sh"
# shellcheck source=../lib/devices.sh
. "$DISTROFETCH_LIB/devices.sh"
# shellcheck source=../lib/hwdata.sh
. "$DISTROFETCH_LIB/hwdata.sh"
# shellcheck source=../lib/render.sh
. "$DISTROFETCH_LIB/render.sh"

usage() {
  cat <<EOF
distrofetch $DISTROFETCH_VERSION — matrix-styled system information

Usage: distrofetch [options]

Options:
      --logo=NAME    force a distro logo (see --list-logos)
      --no-logo      dashboard without the logo column
      --no-art       plain label/value lines: no panels, no logo
      --list-logos   print the bundled logo names and exit
  -d, --duration N   seconds of rain before the dashboard (default: 0)
  -n, --no-rain      skip the animation; the default, kept for explicitness
      --color=WHEN   always, never, or auto (default: auto)
  -c, --no-color     alias for --color=never
  -v, --version      print version and exit
  -h, --help         print this help and exit

The dashboard prints immediately and costs no wall-clock time. It lays out
five panels — system, distribution, processor, memory, machine — beside the
logo of the running distro, in two columns when the terminal is wide enough
and one when it is not. Below 56 columns it falls back to the plain list.

--no-art gives that plain list directly. Use it when something is reading
this output: it is one fact per line, no frame, no logo.

Memory module manufacturer, type, and speed come from the raw SMBIOS tables,
which the kernel exposes at mode 0400. Unprivileged runs say so rather than
printing "unknown"; run "sudo distrofetch" to see them. Nothing else here
needs privilege, and distrofetch never asks for it.

Release dates and end-of-support dates come from SUPPORT_END= in
/etc/os-release where the distro ships it, and from a bundled table
otherwise. A release the table does not know prints "unknown" rather than
a guess.

The animation is off by default — this runs in shell startup files, where two
seconds is a long time to wait. Turn it on with -d:

  distrofetch -d 2

That rains glyphs on the alternate screen, so your scrollback survives.

Color defaults to auto: on for a terminal, off for a pipe or a file, so
redirected output is plain text. Force it when the consumer understands ANSI:

  distrofetch --color=always | less -R

--color=always never enables the animation. Cursor positioning needs a real
terminal, so the rain is skipped off a TTY no matter what color says.

Exit status: 0 on success, 2 on a usage error.
EOF
}

list_logos() {
  local f
  for f in "$DISTROFETCH_LOGOS"/*.txt; do
    [ -r "$f" ] || continue
    f="${f##*/}"
    printf '%s\n' "${f%.txt}"
  done
}

main() {
  # Rain is opt-in: a duration of 0 means no animation at all.
  # Color is resolved after parsing, since auto depends on the TTY check below.
  local rain=1 color=1 duration=0 color_mode=auto art=1 logo=auto

  while [ $# -gt 0 ]; do
    case "$1" in
      -n | --no-rain) rain=0 ;;
      --no-art) art=0 ;;
      --no-logo) logo=none ;;
      --logo=*) logo="${1#--logo=}" ;;
      --logo)
        [ $# -ge 2 ] || die "--logo needs a name; --list-logos prints them"
        logo="$2"
        shift
        ;;
      --list-logos)
        list_logos
        return 0
        ;;
      --color=*) color_mode="${1#--color=}" ;;
      --color)
        [ $# -ge 2 ] || die "--color needs a value: always, never, or auto"
        color_mode="$2"
        shift
        ;;
      -c | --no-color) color_mode=never ;;
      -d | --duration)
        [ $# -ge 2 ] || die "--duration needs a value"
        duration="$2"
        shift
        ;;
      -v | --version)
        printf '%s\n' "$DISTROFETCH_VERSION"
        return 0
        ;;
      -h | --help)
        usage
        return 0
        ;;
      --)
        shift
        break
        ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done

  case "$duration" in
    '' | *[!0-9]*) die "--duration must be a whole number of seconds" ;;
  esac

  # A zero duration must skip render_rain entirely rather than call it with 0 — it
  # clears the screen on the way out, which would be a surprising thing to do by default.
  if [ "$duration" -eq 0 ]; then
    rain=0
  fi

  # The animation is gated on a real terminal regardless of --color: it positions the
  # cursor and clears the screen, which is meaningless in a pipe or a CI log.
  if [ ! -t 1 ]; then
    rain=0
  fi

  case "$color_mode" in
    always) color=1 ;;
    never) color=0 ;;
    auto)
      # Plain text for anything that is not a terminal.
      if [ -t 1 ]; then color=1; else color=0; fi
      ;;
    *) die "--color must be always, never, or auto (got: $color_mode)" ;;
  esac

  # Validate the logo before any output, so a typo fails immediately rather than
  # after half a dashboard has scrolled past.
  case "$logo" in
    auto | none) ;;
    */* | '') die "--logo takes a name, not a path; --list-logos prints them" ;;
    *)
      [ -r "$DISTROFETCH_LOGOS/$logo.txt" ] \
        || die "no such logo: $logo (--list-logos prints them)"
      ;;
  esac

  render_init "$color" "$art"
  DF_LOGO="$logo"
  if [ "$rain" -eq 1 ]; then
    render_rain "$duration"
  fi
  render_report
}

main "$@"
