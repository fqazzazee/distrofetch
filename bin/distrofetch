#!/usr/bin/env bash
# distrofetch — matrix-styled system information for Linux.
#
# Resolves its library directory from either a source checkout (../lib) or an
# installed prefix (../lib/distrofetch), so `git clone` and `make install` both work.

set -euo pipefail

DISTROFETCH_VERSION="0.1.0"

die() {
  printf 'distrofetch: %s\n' "$1" >&2
  exit 2
}

# Follow symlinks so a /usr/local/bin/distrofetch -> ../share/... link still finds lib/.
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _link="$(readlink "$_self")"
  case "$_link" in
    /*) _self="$_link" ;;
    *) _self="$(dirname "$_self")/$_link" ;;
  esac
done
_bindir="$(cd "$(dirname "$_self")" && pwd)"

if [ -d "$_bindir/../lib/distrofetch" ]; then
  DISTROFETCH_LIB="$(cd "$_bindir/../lib/distrofetch" && pwd)"
elif [ -d "$_bindir/../lib" ]; then
  DISTROFETCH_LIB="$(cd "$_bindir/../lib" && pwd)"
else
  die "cannot locate library directory relative to $_bindir"
fi
readonly DISTROFETCH_LIB DISTROFETCH_VERSION

# shellcheck source=../lib/detect.sh
. "$DISTROFETCH_LIB/detect.sh"
# shellcheck source=../lib/render.sh
. "$DISTROFETCH_LIB/render.sh"

usage() {
  cat <<EOF
distrofetch $DISTROFETCH_VERSION — matrix-styled system information

Usage: distrofetch [options]

Options:
  -d, --duration N   seconds of rain before the report settles (default: 0)
  -n, --no-rain      skip the animation; the default, kept for explicitness
  -c, --no-color     disable ANSI color (implies --no-rain)
  -v, --version      print version and exit
  -h, --help         print this help and exit

The animation is off by default — this runs in shell startup files, where two
seconds is a long time to wait. Turn it on with -d:

  distrofetch -d 2

Both the animation and color switch off automatically when stdout is not a
terminal, so piped and redirected output is always plain text.

Exit status: 0 on success, 2 on a usage error.
EOF
}

main() {
  # Rain is opt-in: a duration of 0 means no animation at all.
  local rain=1 color=1 duration=0

  while [ $# -gt 0 ]; do
    case "$1" in
      -n | --no-rain) rain=0 ;;
      -c | --no-color)
        color=0
        rain=0
        ;;
      -d | --duration)
        [ $# -ge 2 ] || die "--duration needs a value"
        duration="$2"
        shift
        ;;
      -v | --version)
        printf '%s\n' "$DISTROFETCH_VERSION"
        return 0
        ;;
      -h | --help)
        usage
        return 0
        ;;
      --)
        shift
        break
        ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done

  case "$duration" in
    '' | *[!0-9]*) die "--duration must be a whole number of seconds" ;;
  esac

  # A zero duration must skip render_rain entirely rather than call it with 0 — it
  # clears the screen on the way out, which would be a surprising thing to do by default.
  if [ "$duration" -eq 0 ]; then
    rain=0
  fi

  # Nothing to animate into if stdout is a pipe, a file, or a CI log — and nothing that
  # would render color, either. Both go off together so redirected output is plain text.
  if [ ! -t 1 ]; then
    rain=0
    color=0
  fi

  render_init "$color"
  if [ "$rain" -eq 1 ]; then
    render_rain "$duration"
  fi
  render_report
}

main "$@"
